  "components": {
    "schemas": {
      "ExpressReview": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique ID of the review"
          },
          "title": {
            "type": "string",
            "description": "Title of the review"
          },
          "content": {
            "type": "string",
            "description": "Review content"
          },
          "rating": {
            "type": "number",
            "format": "float",
            "description": "Rating score of the review"
          },
          "category": {
            "type": "string",
            "description": "Category of the review"
          },
          "author": {
            "type": "string",
            "description": "Name of the review author"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the review was published"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "internal_code": {
            "type": "string"
          }
        }
      },
      "SpringBootTopRatedMovie": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique ID of the movie"
          },
          "name": {
            "type": "string",
            "description": "Title of the movie"
          },
          "link": {
            "type": "string",
            "description": "Link of the proper Poster"
          },
          "rating": {
            "type": "number",
            "format": "float",
            "description": "Rating score of the movie"
          }
        }
      },
      "SpringBootTopMovieByGenre": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique ID of the movie"
          },
          "name": {
            "type": "string",
            "description": "Title of the movie"
          },
          "link": {
            "type": "string",
            "description": "Link of the proper Poster"
          }
        }
      },
      "SpringBootTopMovieByName": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique ID of the movie"
          },
          "name": {
            "type": "string",
            "description": "Title of the movie"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "date of the movie"
          },
          "link": {
            "type": "string",
            "description": "Link of the proper Poster"
          }
        }
      },
      "SpringBootGenreName": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the genre"
          }
        }
      },
      "ExpressDiscussion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "messages": {
            "$ref": "#/components/schemas/ExpressMessage"
          }
        }
      },
      "ExpressDiscussionInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "movie": {
            "$ref": "#/components/schemas/ExpressMovie"
          }
        }
      },
      "ExpressMessage": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string",
            "description": "Sender's username of the new message"
          },
          "message": {
            "type": "string",
            "description": "Text of the new message"
          },
          "image": {
            "type": "string",
            "description": "Image if specified"
          },
          "id_room": {
            "type": "string",
            "description": "Room's id in which user wants to send the new message/image"
          },
          "time_stamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the new message"
          }
        }
      },
      "ExpressMessageInput": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string",
            "description": "Sender's username"
          },
          "message": {
            "type": "string",
            "description": "Text content of the message"
          },
          "id_room": {
            "type": "string",
            "description": "Identifier of the discussion room"
          }
        },
        "required": [
          "sender",
          "message",
          "id_room"
        ]
      },
      "ExpressImageInput": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string",
            "description": "Sender's username"
          },
          "image": {
            "type": "string",
            "description": "URL or data of the image/video"
          },
          "id_room": {
            "type": "string",
            "description": "Identifier of the discussion room"
          }
        },
        "required": [
          "sender",
          "image",
          "id_room"
        ]
      },
      "ExpressMovie": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the movie."
          },
          "name": {
            "type": "string",
            "description": "Title of the movie."
          },
          "year": {
