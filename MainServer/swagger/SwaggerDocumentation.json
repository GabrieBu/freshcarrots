{
  "openapi": "3.0.2",
  "info": {
    "title": "Main Server - Central Dispatcher",
    "version": "1.0",
    "description": "Central server routing requests to the static data server (SpringBoot) or the dynamic data server (Express).",
    "termsOfService": "http://api_url/terms/"
  },
  "servers": [
    {
      "url": "http://localhost:3000/",
      "description": "dev"
    }
  ],
  "tags": [
    {
      "name": "Reviews",
      "description": "Operations related to movie reviews (proxied to Express)."
    },
    {
      "name": "Movies",
      "description": "Operations related to movie data (proxied to SpringBoot)."
    },
    {
      "name": "Discussions",
      "description": "Operations related to community discussions (proxied to Express)."
    },
    {
      "name": "Messages",
      "description": "Operations related to messages within discussions (proxied to Express)."
    },
    {
      "name": "Genres",
      "description": "Operations related to movie genres (proxied to SpringBoot)."
    }
  ],
  "paths": {
    "/getReviews": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "description": "Proxies the request to the dynamic data server (Express) to fetch available reviews, applying filters specified in the query parameters.",
        "operationId": "getExpressReviews",
        "parameters": [
          {
            "in": "query",
            "name": "criticFilter",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "Filter reviews by either top critic or normal ones"
          },
          {
            "in": "query",
            "name": "typeFilter",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter reviews by either f or normal ones"
          },
          {
            "in": "query",
            "name": "minDateFilter",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "required": false,
            "description": "Filter reviews by min Date."
          },
          {
            "in": "query",
            "name": "maxDateFilter",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "required": false,
            "description": "Filter reviews by max Date."
          },
          {
            "in": "query",
            "name": "reviewMovieFilter",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter reviews by Movie Title."
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Page number for pagination (passed to Express)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved list of reviews (response from Express).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExpressReview"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Error in Main Server or the Express server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Error occurred: getReviews Internal Server Error",
                  "internal_code": "proxy_error_express"
                }
              }
            }
          }
        }
      }
    },
