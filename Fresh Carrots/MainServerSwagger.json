        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Number of the query page (page size = 45)"
          },
          {
            "in": "query",
            "name": "order",
            "schema": {
              "type": "string",
              "enum": ["ascName", "descName", "ascDate", "descDate"]
            },
            "required": false,
            "description": "Order movies by name or date ASC/DESC"
          },
          {
            "in": "query",
            "name": "ratingRange",
            "schema": {
              "type": "string",
              "enum": ["zeroToOne","oneToTwo", "twoToThree", "threeToFour", "fourToFive"]
            },
            "required": false,
            "description": "Order movies by ranges of value rating"

          },
          {
            "in": "query",
            "name": "genre",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Genre name of the movie"
