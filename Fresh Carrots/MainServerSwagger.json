    "/getMessages": {
      "get": {
        "tags": [
          "Messages"
        ],
        "description": "Proxies the request to the dynamic data server (Express) to retrieve messages for a discussion room.",
        "operationId": "getExpressMessages",
        "parameters": [
          {
            "in": "query",
            "name": "id_room",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Unique identifier of the discussion room"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Page number for pagination (results per page: 50)."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of last messages retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/discussionRoomSchema"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Missing required parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorSchema"
                },
                "example": {
                  "error_message": "Bad Request: Missing the required parameter id_room or pageNumber."
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Discussion room not found for the specified ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorSchema"
                },
                "example": {
                  "error_message": "Not Found: Discussion room with the specified ID does not exist."
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - An unexpected error occurred while retrieving messages.",
            "content": {
