{
  "openapi": "3.0.2",
  "info": {
    "title": "Main Server - Central Dispatcher",
    "version": "1.0",
    "description": "Central server routing requests to the static data server (SpringBoot) or the dynamic data server (Express).",
    "termsOfService": "http://api_url/terms/"
  },
  "servers": [
    {
      "url": "http://localhost:3000/",
      "description": "dev"
    }
  ],
  "tags": [
    {
      "name": "Reviews",
      "description": "Operations related to movie reviews (proxied to Express)."
    },
    {
      "name": "Movies",
      "description": "Operations related to movie data (proxied to SpringBoot)."
    },
    {
      "name": "Discussions",
      "description": "Operations related to community discussions (proxied to Express)."
    },
    {
      "name": "Messages",
      "description": "Operations related to messages within discussions (proxied to Express)."
    },
    {
      "name": "Genres",
      "description": "Operations related to movie genres (proxied to SpringBoot)."
    }
  ],
  "paths": {
    "/getReviews": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "description": "Proxies the request to the dynamic data server (Express) to fetch available reviews, applying filters specified in the query parameters.",
        "operationId": "getExpressReviews",
        "parameters": [
          {
            "in": "query",
            "name": "criticFilter",
            "schema": {
              "type": "string",
              "enum": [
                "all_critics",
                "True",
                "False"
              ]
            },
            "required": false,
            "description": "Filter reviews by Top Critic status (true for Top Critic reviews)."
          },
          {
            "in": "query",
            "name": "typeFilter",
            "schema": {
              "type": "string",
              "enum": [
                "all_types",
                "Fresh",
                "Rotten"
              ]
            },
            "required": false,
            "description": "Filter reviews by a specific type or category (fresh or rotten)"
          },
          {
            "in": "query",
            "name": "minDateFilter",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "required": false,
            "description": "Filter reviews published on or after this date (YYYY-MM-DD)."
          },
          {
            "in": "query",
            "name": "maxDateFilter",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "required": false,
            "description": "Filter reviews published on or before this date (YYYY-MM-DD)."
          },
          {
            "in": "query",
            "name": "reviewMovieFilter",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter reviews where the movie title contains this string (case-insensitive)."
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Page number for pagination (results per page: 10)."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of reviews retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/reviewSchema"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - An unexpected error occurred on the server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorSchema"
                },
                "example": {
                  "error_message": "Internal Server Error: Failed to retrieve reviews."
                }
              }
            }
          }
        }
      }
    },
